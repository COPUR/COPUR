{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copur.github.io/schemas/portfolio-catalog.v1.schema.json",
  "title": "COPUR Enterprise Portfolio SSOT Catalog",
  "description": "TOGAF ADM Phase C canonical data contract for portfolio projections (README.md, PROJECTS.md, docs/index.html, briefs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "metadata",
    "engineeringStandards",
    "domains",
    "suites",
    "repositories",
    "briefs",
    "proofLinks"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "metadata": { "$ref": "#/$defs/catalogMetadata" },
    "engineeringStandards": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/engineeringStandard" }
    },
    "domains": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domainEntry" }
    },
    "suites": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/suiteEntry" }
    },
    "repositories": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryEntry" }
    },
    "briefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/briefEntry" }
    },
    "proofLinks": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/proofLinkEntry" }
    }
  },
  "$defs": {
    "slugId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    },
    "domainIdEnum": {
      "type": "string",
      "enum": [
        "D1_AGENTIC_AI",
        "D2_OPEN_FINANCE_CORE",
        "D3_EV_MOBILITY",
        "D4_SERVERLESS_INTELLIGENCE"
      ]
    },
    "suiteIdPattern": {
      "type": "string",
      "pattern": "^suite-(?:0[1-9]|10)-[a-z0-9-]+$",
      "maxLength": 96
    },
    "maturityTierEnum": {
      "type": "string",
      "enum": [
        "RUNNABLE_K8S_CLI_DEMO",
        "PUBLIC_REFERENCE_BASELINE",
        "CONTRACT_FIRST_ECOSYSTEM",
        "GOVERNED_PRIVATE_ENTERPRISE_BASELINE"
      ]
    },
    "visibilityEnum": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "PRIVATE",
        "IN_DESIGN",
        "PENDING_REPO_VERIFICATION"
      ]
    },
    "evidenceTypeEnum": {
      "type": "string",
      "enum": [
        "QUICKSTART_DEEP_LINK",
        "CONTRACT_SPEC",
        "TESTKIT_OR_SIMULATOR",
        "C4_ARCHITECTURE_BRIEF",
        "ADR_OR_BENCHMARK"
      ]
    },
    "standardNameEnum": {
      "type": "string",
      "enum": [
        "Deterministic Sandwich",
        "Contract-First Governance",
        "Zero-Trust & Residency",
        "Air-Gapped / On-Prem AI"
      ]
    },
    "sponsorTypeEnum": {
      "type": "string",
      "enum": [
        "ENTERPRISE_PLATFORM_GOVERNANCE",
        "OPEN_FINANCE_CORE_BANKING",
        "CENTRALIZED_REGULATOR",
        "ECOSYSTEM_STAKEHOLDERS_FINTECH_CPO",
        "AUTOMOTIVE_RD_DRIVER_EXPERIENCE",
        "SERVERLESS_SAAS_RD"
      ]
    },
    "catalogMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "catalogRevision",
        "lastVerifiedAt",
        "owner",
        "verificationPolicy"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "catalogRevision": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:\\.\\d+)?$" },
        "lastVerifiedAt": { "type": "string", "minLength": 10 },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "githubHandle",
            "roleTitle",
            "portfolioUrl",
            "githubProfileUrl",
            "discussionsUrl",
            "catalogUrl"
          ],
          "properties": {
            "name": { "type": "string", "minLength": 2, "maxLength": 100 },
            "githubHandle": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
            "roleTitle": { "type": "string", "minLength": 5, "maxLength": 140 },
            "portfolioUrl": { "type": "string", "pattern": "^https://" },
            "githubProfileUrl": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+$" },
            "discussionsUrl": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/discussions$" },
            "catalogUrl": { "type": "string", "pattern": "^https://github\\.com/" }
          }
        },
        "verificationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "githubDiscoveryCommand",
            "publicLinkRule",
            "hygienePolicyRef"
          ],
          "properties": {
            "githubDiscoveryCommand": { "type": "string", "const": "gh api --paginate" },
            "publicLinkRule": { "type": "string", "const": "PUBLIC_REPOS_ONLY" },
            "hygienePolicyRef": { "type": "string", "minLength": 3, "maxLength": 120 }
          }
        }
      }
    },
    "engineeringStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standardId", "order", "name", "implementationStandard"],
      "properties": {
        "standardId": { "$ref": "#/$defs/slugId" },
        "order": { "type": "integer", "minimum": 1, "maximum": 4 },
        "name": { "$ref": "#/$defs/standardNameEnum" },
        "implementationStandard": { "type": "string", "minLength": 15, "maxLength": 320 }
      }
    },
    "domainEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "domainNumber",
        "title",
        "shortTitle",
        "targetAudience",
        "executiveSummary"
      ],
      "properties": {
        "domainId": { "$ref": "#/$defs/domainIdEnum" },
        "domainNumber": { "type": "integer", "minimum": 1, "maximum": 4 },
        "title": { "type": "string", "minLength": 5, "maxLength": 120 },
        "shortTitle": { "type": "string", "minLength": 3, "maxLength": 60 },
        "targetAudience": { "type": "string", "minLength": 5, "maxLength": 180 },
        "executiveSummary": { "type": "string", "minLength": 15, "maxLength": 420 },
        "domainBoundaryNote": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "enterpriseControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 100 },
        "description": { "type": "string", "minLength": 10, "maxLength": 360 }
      }
    },
    "suiteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteId",
        "suiteNumber",
        "domainId",
        "renderOrderInDomain",
        "title",
        "shortTitle",
        "targetAudience",
        "sponsorType",
        "sponsorLabel",
        "maturityTier",
        "valueProposition",
        "businessProblem",
        "enterpriseControls",
        "techStack",
        "tags",
        "standardIds"
      ],
      "properties": {
        "suiteId": { "$ref": "#/$defs/suiteIdPattern" },
        "suiteNumber": { "type": "integer", "minimum": 1, "maximum": 10 },
        "domainId": { "$ref": "#/$defs/domainIdEnum" },
        "renderOrderInDomain": { "type": "integer", "minimum": 1, "maximum": 4 },
        "title": { "type": "string", "minLength": 5, "maxLength": 120 },
        "shortTitle": { "type": "string", "minLength": 4, "maxLength": 80 },
        "targetAudience": { "type": "string", "minLength": 4, "maxLength": 160 },
        "sponsorType": { "$ref": "#/$defs/sponsorTypeEnum" },
        "sponsorLabel": { "type": "string", "minLength": 4, "maxLength": 120 },
        "sponsorBoundaryNote": { "type": ["string", "null"], "maxLength": 280 },
        "maturityTier": { "$ref": "#/$defs/maturityTierEnum" },
        "valueProposition": { "type": "string", "minLength": 20, "maxLength": 520 },
        "businessProblem": { "type": "string", "minLength": 20, "maxLength": 520 },
        "enterpriseControls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/enterpriseControl" }
        },
        "techStack": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 48 }
        },
        "tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 36 }
        },
        "standardIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slugId" }
        }
      }
    },
    "repositoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoId",
        "entryKind",
        "githubRepoName",
        "displayName",
        "canonicalSuiteId",
        "referencedBySuites",
        "visibility",
        "maturityTier",
        "roleInSuite",
        "summary",
        "displayOrder"
      ],
      "properties": {
        "repoId": { "$ref": "#/$defs/slugId" },
        "entryKind": { "type": "string", "enum": ["GITHUB_REPO", "SUB_PRODUCT", "CONCEPT_PRODUCT"] },
        "githubRepoName": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "shortLabel": { "type": ["string", "null"], "minLength": 2, "maxLength": 64 },
        "canonicalSuiteId": { "$ref": "#/$defs/suiteIdPattern" },
        "referencedBySuites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/suiteIdPattern" }
        },
        "visibility": { "$ref": "#/$defs/visibilityEnum" },
        "maturityTier": { "$ref": "#/$defs/maturityTierEnum" },
        "roleInSuite": { "type": "string", "minLength": 3, "maxLength": 100 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 280 },
        "verificationNote": { "type": ["string", "null"], "maxLength": 220 },
        "displayOrder": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "briefEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "slug",
        "suiteId",
        "title",
        "subtitle",
        "contextSummary",
        "architectureHighlights",
        "guardrailsAndCompliance",
        "diagramMermaid"
      ],
      "properties": {
        "assetId": { "$ref": "#/$defs/slugId" },
        "slug": { "$ref": "#/$defs/slugId" },
        "suiteId": { "$ref": "#/$defs/suiteIdPattern" },
        "title": { "type": "string", "minLength": 5, "maxLength": 140 },
        "subtitle": { "type": "string", "minLength": 5, "maxLength": 220 },
        "contextSummary": { "type": "string", "minLength": 20, "maxLength": 700 },
        "architectureHighlights": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 8, "maxLength": 260 }
        },
        "guardrailsAndCompliance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 8, "maxLength": 260 }
        },
        "diagramMermaid": { "type": "string", "minLength": 15, "maxLength": 2400 }
      }
    },
    "proofLinkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proofId",
        "suiteId",
        "evidenceType",
        "targetKind",
        "repoId",
        "pathOrFragment",
        "assetId",
        "title",
        "summary",
        "displayOrder"
      ],
      "properties": {
        "proofId": { "$ref": "#/$defs/slugId" },
        "suiteId": { "$ref": "#/$defs/suiteIdPattern" },
        "evidenceType": { "$ref": "#/$defs/evidenceTypeEnum" },
        "targetKind": { "type": "string", "enum": ["PUBLIC_GITHUB_REPO", "PORTFOLIO_ASSET"] },
        "repoId": { "type": ["string", "null"] },
        "pathOrFragment": { "type": ["string", "null"] },
        "assetId": { "type": ["string", "null"] },
        "title": { "type": "string", "minLength": 5, "maxLength": 140 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 280 },
        "displayOrder": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    }
  }
}
